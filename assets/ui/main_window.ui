<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pytrolio – main window layout (Qt Designer file).

  Loaded at runtime by app.py. Widgets are found by their objectName, so keep
  the names when editing. Styling lives in assets/theme/theme.qss and targets
  the dynamic properties set here (role, card, variant, nav, pill, …).

  Filled in by code (because it depends on the installed pytr version):
    * navTasks   – one sidebar button per pytr task
    * formStack  – the settings form of each task
-->
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>880</height></rect>
  </property>
  <property name="minimumSize">
